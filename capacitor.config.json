{
  "appId": "com.yyf.workbench",
  "appName": "个人工作台",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#f4f3f0",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "androidSplashResourceName": "splash"
    },
    "StatusBar": {
      "backgroundColor": "#f4f3f0",
      "style": "LIGHT",
      "overlaysWebView": true
    }
  }
}
